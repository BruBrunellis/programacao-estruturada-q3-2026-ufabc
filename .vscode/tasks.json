{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C: compilar arquivo ativo",
      "type": "process",
      "command": "gcc",
      "args": [
        "-std=c17", "-Wall", "-Wextra", "-Wpedantic", "-g", "-O0",
        "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}.out", "-lm"
      ],
      "windows": {
        "args": [
          "-std=c17", "-Wall", "-Wextra", "-Wpedantic", "-g", "-O0",
          "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}.exe", "-lm"
        ]
      },
      "options": {"cwd": "${fileDirname}"},
      "problemMatcher": ["$gcc"],
      "group": {"kind": "build", "isDefault": true}
    },
    {
      "label": "C: compilar e executar arquivo ativo",
      "type": "process",
      "command": "${fileDirname}/${fileBasenameNoExtension}.out",
      "windows": {"command": "${fileDirname}/${fileBasenameNoExtension}.exe"},
      "dependsOn": "C: compilar arquivo ativo",
      "dependsOrder": "sequence",
      "options": {"cwd": "${fileDirname}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "focus": true, "panel": "dedicated"}
    }
  ]
}
